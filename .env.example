AUTH_SECRET_KEY=agframe-local-dev-secret-key-0123456789

POSTGRES_USER=agframe
POSTGRES_PASSWORD=agframe_secret
POSTGRES_DB=agframe
DB_TYPE=postgres
# Docker Compose defaults use the service name `postgres`.
# When starting backend/worker directly on the host, override this to `127.0.0.1`.
DATABASE_URL=postgresql+psycopg://agframe:agframe_secret@postgres:5432/agframe
DB_HOST=postgres
DB_PORT=5432
DB_USER=agframe
DB_PASSWORD=agframe_secret
DB_NAME=agframe

REDIS_PASSWORD=redissecret
# Docker Compose defaults use the service name `redis`.
# When starting backend/worker directly on the host, override this to `127.0.0.1`.
REDIS_URL=redis://:redissecret@redis:6379/0

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Default local path: use stub chat + stub embeddings so startup works without a cloud key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=dev-stub
MODEL_PATH_EMBEDDING=dev-stub

# Optional Langfuse keys. Only needed when starting with --profile observability.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
