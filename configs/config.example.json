{
  "llm": {
    "api_key": "",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o"
  },
  "model_manager": {
    "provider": "modelscope",
    "cache_dir": "",
    "revision": "",
    "trust_remote_code": true,
    "modelscope_fallback_to_hf": true
  },
  "local_models": {
    "ocr_model": "",
    "embedding_model": "Qwen/Qwen3-Embedding-0.6B",
    "rerank_model": ""
  },
  "embeddings": {
    "provider": "modelscope",
    "backend": "sentence_transformers",
    "model_name": "Qwen/Qwen3-Embedding-0.6B",
    "base_url": "",
    "api_key": "",
    "timeout_seconds": 30,
    "env_var": "MODEL_PATH_EMBEDDING",
    "device": "auto",
    "batch_size": 32,
    "max_length": 512,
    "pooling": "mean",
    "normalize": true,
    "query_prefix": "",
    "doc_prefix": ""
  },
  "reranker": {
    "provider": "modelscope",
    "backend": "sentence_transformers",
    "model_name": "",
    "base_url": "",
    "api_key": "",
    "timeout_seconds": 30,
    "env_var": "MODEL_PATH_RERANKER",
    "device": "auto",
    "batch_size": 16,
    "max_length": 512,
    "query_prefix": "",
    "doc_prefix": "",
    "window_size": null,
    "stride": null,
    "transformers_model_type": "auto"
  },
  "search": {
    "provider": "duckduckgo",
    "tavily_api_key": ""
  },
  "database": {
    "type": "postgres",
    "url": "postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>",
    "host": "localhost",
    "port": 5432,
    "user": "postgres",
    "password": "<DB_PASSWORD>",
    "db_name": "agent_app"
  },
  "queue": {
    "redis_url": "redis://:redissecret@localhost:6379/0"
  },
  "storage_backend": "local",
  "storage_s3": {
    "s3_endpoint": "",
    "s3_access_key": "",
    "s3_secret_key": "",
    "s3_bucket": "agframe",
    "s3_secure": false
  },
  "auth": {
    "secret_key": "<AUTH_SECRET_KEY_AT_LEAST_32_CHARS>",
    "algorithm": "HS256",
    "access_token_expire_minutes": 30,
    "allow_open_registration": true,
    "bootstrap_admin_token": ""
  },
  "general": {
    "app_name": "My Agent App"
  },
  "rag": {
    "retrieval": {
      "mode": "hybrid",
      "dense_k": 20,
      "sparse_k": 20,
      "candidate_k": 20,
      "final_k": 3,
      "rrf_k": 60,
      "weights": [0.5, 0.5]
    }
  },
  "prompt": {
    "budget": {
      "max_recent_history_lines": 10,
      "max_docs": 3,
      "max_memories": 3,
      "max_doc_chars_total": 6000,
      "max_memory_chars_total": 3000,
      "max_profile_chars_total": 2500,
      "max_item_chars": 2000
    },
    "context_pruning": {
      "enabled": true,
      "method": "heuristic",
      "auto_reranker_min_lines": 40,
      "auto_reranker_min_chars": 2500,
      "min_keywords": 2,
      "min_keep_lines": 4,
      "max_keep_ratio": 0.45,
      "neighbor_window": 1,
      "reranker_window_radius": 1,
      "max_lines_per_item": 24,
      "score_threshold": 0.18
    }
  },
  "nodes": {
    "enabled": [
      "router",
      "retrieve_docs",
      "retrieve_memories",
      "assemble",
      "generate"
    ]
  },
  "feature_flags": {
    "enable_docs_rag": true,
    "enable_chat_memory": true,
    "enable_self_correction": true,
    "allow_dangerous_deserialization": false,
    "enable_tools_write_file": false,
    "enable_tools_python_repl": false,
    "enable_tools_python_executor": false,
    "pgvector_dimension": 1024
  },
  "sandbox": {
    "enabled": false,
    "image": "python:3.12-slim",
    "timeout": 30,
    "memory_limit": "256m",
    "cpu_limit": 0.5
  },
  "self_correction": {
    "max_attempts": 2
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "cors_origins": [],
    "cors_allow_credentials": false
  },
  "mcp": {
    "servers": [
      {
        "server_id": "filesystem",
        "title": "Filesystem",
        "description": "Example metadata-only MCP inventory entry for Harness capability planning.",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "/absolute/path/to/workspace"
        ],
        "enabled": false
      }
    ]
  },
  "storage_local": {
    "documents_dir": "data/documents",
    "uploads_dir": "data/uploads",
    "data_dir": "data"
  }
}
